# Copie este arquivo para .env e preencha os valores. O .env nunca deve ser versionado.

# Provedor do LLM: gemini (gratuito via Google AI Studio) ou claude
FUEL_LLM_PROVIDER=gemini

# Chave do Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Chave da Anthropic (apenas se FUEL_LLM_PROVIDER=claude)
ANTHROPIC_API_KEY=

# Opcionais (valores padrão em src/fuel_agent/config.py)
# FUEL_LLM_MODEL=gemini-3.8-flash
# FUEL_HORIZON_DAYS=7
# FUEL_NEWS_MAX_AGE_DAYS=10
